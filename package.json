{
  "name": "sum-playlist-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop thumbnail and playlist video automation for YouTube music channels.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.1976haru.sumstudio",
    "productName": "SUM Playlist Studio",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "SUM-Playlist-Studio-${version}.${ext}"
    }
  }
}
